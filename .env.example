# Environment Settings
PROJECT_NAME="DesiDhar D2C Store API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database (PostgreSQL + asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/desidhar_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=False

# Redis Cache & Sessions
REDIS_URL="redis://localhost:6379/0"
REDIS_GUEST_CART_TTL_SECONDS=604800

# Security & JWT Tokens
JWT_SECRET_KEY="replace-with-a-very-strong-cryptographic-random-secret-key-at-least-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""

# CORS Allowed Origins (Comma separated or JSON array)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Payment Gateways
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Default Super Admin Seed Credentials
FIRST_SUPER_ADMIN_EMAIL="admin@desidhar.com"
FIRST_SUPER_ADMIN_PASSWORD="SuperAdmin@2026!"
FIRST_SUPER_ADMIN_FIRST_NAME="Super"
FIRST_SUPER_ADMIN_LAST_NAME="Admin"

# Rate Limiting
DEFAULT_RATE_LIMIT="100/minute"
AUTH_RATE_LIMIT="10/minute"
