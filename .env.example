# Application
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/desidhar

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CUSTOMER_TOKEN_EXPIRE_DAYS=7

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@desidhar.com
SMTP_TLS=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173